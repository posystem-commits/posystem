# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string — used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Optional — powers the in-app "Help & troubleshooting" chat on the POS terminal
# (app/api/pos/[tenantId]/help). Leave blank to leave that feature disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
